# Banco Neon (Console Neon > projeto "eletric" > Connect)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Senha para entrar no app (só você usa)
APP_PASSWORD=troque-esta-senha

# Segredo para assinar a sessão (gere com: openssl rand -base64 32)
AUTH_SECRET=gere-um-segredo-aleatorio

# Chave da API do Claude (console.anthropic.com) — usada pela IA especialista e pela aba Vendas
ANTHROPIC_API_KEY=
